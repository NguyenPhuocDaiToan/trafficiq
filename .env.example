# Copy sang .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# --- MongoDB Atlas ---------------------------------------------------------
# Atlas → Database → Connect → Drivers. Nhớ URL-encode password nếu có ký tự đặc biệt.
# Network Access phải cho phép 0.0.0.0/0 (Vercel không có IP tĩnh trên Hobby/Pro).
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="trafficiq"

# --- Retention -------------------------------------------------------------
# TTL cho clickEvents. M0 chỉ 512MB: ~50k click/ngày sẽ đầy trong 2-4 tuần nếu
# không có TTL. Đổi giá trị này rồi chạy lại `npm run setup:indexes`.
CLICK_TTL_DAYS="30"

# --- Secrets ---------------------------------------------------------------
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Salt để hash IP. IP là PII nên không lưu thô.
# CẢNH BÁO: đổi salt = mọi hash cũ không còn khớp => số "unique visitors" lịch sử sai.
IP_HASH_SALT=""

# Dùng cho cả /api/postback (advertiser gọi vào) và /api/rollup (cron gọi vào).
POSTBACK_SECRET=""

# Mật khẩu vào /admin.
ADMIN_PASSWORD=""

# --- Lưu ảnh tải lên ---------------------------------------------------------
# MongoDB chỉ lưu ĐƯỜNG DẪN/URL ảnh, không bao giờ lưu byte ảnh. Chọn nơi lưu bằng MỘT cờ:
#
#   STORAGE_DRIVER = disk | vercel | s3
#
#   vercel  Vercel Blob. MẶC ĐỊNH khi để trống (dự án deploy CI/CD lên Vercel).
#   disk    Ghi ra đĩa của máy chạy app (VM, hoặc local để phát triển). KHÔNG dùng được trên Vercel.
#   s3      AWS S3 / Cloudflare R2 / MinIO / Backblaze B2 (mọi dịch vụ tương thích S3).
#
# Để trống = vercel, cần BLOB_READ_WRITE_TOKEN; thiếu thì nút "Tải ảnh lên" báo lỗi, còn dán link ảnh
# luôn dùng được. Chạy local không có token: đặt STORAGE_DRIVER="disk".
# Đổi driver sau này không làm hỏng campaign cũ: ảnh cũ vẫn mở được qua đường dẫn/URL đã lưu.
# STORAGE_DRIVER="vercel"

# -- disk (cần STORAGE_DRIVER="disk") --
# Đặt NGOÀI thư mục deploy, đường dẫn TUYỆT ĐỐI (vd /var/lib/trafficiq/uploads), nếu không mỗi
# lần deploy lại là mất ảnh; user chạy app phải có quyền ghi. Để trống khi chạy local → ./uploads.
# UPLOAD_DIR="/var/lib/trafficiq/uploads"

# -- vercel (mặc định) --
# Vercel dashboard → Storage → Create → Blob (chọn PUBLIC) → Connect Project: Vercel tự thêm biến này.
# Chạy local thì `vercel env pull` hoặc dán token vào .env.local.
# BLOB_READ_WRITE_TOKEN=""

# -- s3 --
# S3_BUCKET="trafficiq-media"
# Gốc URL công khai của object (domain CDN hoặc URL bucket), KHÔNG có "/" cuối. Bucket phải đọc được công khai.
# S3_PUBLIC_URL="https://media.example.com"
# AWS: bắt buộc S3_REGION. R2/MinIO (có S3_ENDPOINT): region mặc định "auto".
# S3_REGION="ap-southeast-1"
# Chỉ cho dịch vụ không phải AWS:
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# MinIO và một số dịch vụ tự dựng cần "true":
# S3_FORCE_PATH_STYLE="false"
# Bỏ trống CẢ HAI khoá để dùng IAM role / profile mặc định của AWS SDK.
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Tiền tố khoá object (mặc định campaign-images/):
# S3_KEY_PREFIX="campaign-images/"

# --- URL công khai ---------------------------------------------------------
# Để trống trên Vercel: code tự lấy từ VERCEL_PROJECT_PRODUCTION_URL.
# Cần set nếu dùng custom domain, vì OG image bắt buộc absolute URL.
# NEXT_PUBLIC_BASE_URL="https://trafficiq.example.com"

# --- Website công khai (blog / trang pháp lý) ------------------------------
# Các biến NEXT_PUBLIC_* được nhúng vào HTML lúc build => KHÔNG đặt secret ở đây.

# Email hiện trên /lien-he và trong các trang pháp lý.
# Bỏ trống thì code dùng "lien-he@example.com" — placeholder, KHÔNG phải hộp thư thật.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Pháp nhân vận hành. Tùy chọn: bỏ trống thì /dieu-khoan và /chinh-sach-bao-mat
# ghi tên site (SITE.name) là bên vận hành — đúng cho một blog cá nhân, không bịa
# tên công ty. Điền đủ ba biến (và cho legal review) khi chạy traffic trả tiền.
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_TAX_ID=""

# --- Tuning (tùy chọn) -----------------------------------------------------
# TTL cache routing map trong RAM của mỗi instance (ms). Cao hơn = ít query Mongo
# hơn nhưng pause campaign lâu có hiệu lực hơn.
# ROUTE_CACHE_TTL_MS="60000"
