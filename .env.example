# Copy sang .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# --- MongoDB Atlas ---------------------------------------------------------
# Atlas → Database → Connect → Drivers. Nhớ URL-encode password nếu có ký tự đặc biệt.
# Network Access phải cho phép 0.0.0.0/0 (Vercel không có IP tĩnh trên Hobby/Pro).
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="trafficiq"

# --- Retention -------------------------------------------------------------
# TTL cho clickEvents. M0 chỉ 512MB: ~50k click/ngày sẽ đầy trong 2-4 tuần nếu
# không có TTL. Đổi giá trị này rồi chạy lại `npm run setup:indexes`.
CLICK_TTL_DAYS="30"

# --- Secrets ---------------------------------------------------------------
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Salt để hash IP. IP là PII nên không lưu thô.
# CẢNH BÁO: đổi salt = mọi hash cũ không còn khớp => số "unique visitors" lịch sử sai.
IP_HASH_SALT=""

# Dùng cho cả /api/postback (advertiser gọi vào) và /api/rollup (cron gọi vào).
POSTBACK_SECRET=""

# Mật khẩu vào /admin.
ADMIN_PASSWORD=""

# --- URL công khai ---------------------------------------------------------
# Để trống trên Vercel: code tự lấy từ VERCEL_PROJECT_PRODUCTION_URL.
# Cần set nếu dùng custom domain, vì OG image bắt buộc absolute URL.
# NEXT_PUBLIC_BASE_URL="https://trafficiq.example.com"

# --- Tuning (tùy chọn) -----------------------------------------------------
# TTL cache routing map trong RAM của mỗi instance (ms). Cao hơn = ít query Mongo
# hơn nhưng pause campaign lâu có hiệu lực hơn.
# ROUTE_CACHE_TTL_MS="60000"
